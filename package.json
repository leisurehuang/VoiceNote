{
  "name": "voice-notes",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n backend,web -c blue,green \"npm:dev:backend\" \"npm:dev:web\"",
    "dev:backend": "npm run dev -w @voice-notes/backend",
    "dev:web": "npm run dev -w @voice-notes/frontend",
    "build": "npm run build -w @voice-notes/frontend",
    "start": "npm run start -w @voice-notes/backend",
    "setup": "bash scripts/setup.sh",
    "typecheck": "npm run typecheck -w @voice-notes/backend && npm run typecheck -w @voice-notes/frontend && npm run typecheck -w @voice-notes/desktop",
    "bundle:backend": "esbuild packages/backend/src/index.ts --bundle --platform=node --format=cjs --outfile=resources/app/backend.cjs",
    "desktop:dev": "npm run dev -w @voice-notes/desktop",
    "desktop:dist": "npm run dist -w @voice-notes/desktop",
    "test": "npm run test -w @voice-notes/backend",
    "lint": "eslint .",
    "format": "prettier --write \"packages/**/*.{ts,tsx,cjs,mjs,css,js}\" \"scripts/**/*.mjs\"",
    "format:check": "prettier --check \"packages/**/*.{ts,tsx,cjs,mjs,css,js}\" \"scripts/**/*.mjs\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fission-ai/openspec": "^1.8.0",
    "concurrently": "^9.1.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.24.0",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.71.2"
  }
}