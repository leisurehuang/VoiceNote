{
  "name": "@voice-notes/desktop",
  "version": "0.3.0",
  "private": true,
  "description": "Voice Notes 桌面外壳（Electron）",
  "main": "src/main.cjs",
  "author": "voice-notes",
  "scripts": {
    "dev": "npm --prefix ../.. run bundle:backend && npm --prefix ../.. run build && electron .",
    "dev:linux": "npm --prefix ../.. run bundle:backend && npm --prefix ../.. run build && electron . --no-sandbox",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "dist:mac": "electron-builder --mac",
    "dist:all": "electron-builder --win --linux --mac"
  },
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9"
  },
  "build": {
    "extends": null
  }
}
