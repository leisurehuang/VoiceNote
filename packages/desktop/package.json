{
  "name": "@voice-notes/desktop",
  "version": "0.3.0",
  "private": true,
  "description": "Voice Notes 桌面外壳（Electron）",
  "main": "src/main.cjs",
  "author": "voice-notes",
  "repository": {
    "type": "git",
    "url": "https://github.com/leisurehuang/VoiceNote.git"
  },
  "scripts": {
    "dev": "npm --prefix ../.. run bundle:backend && npm --prefix ../.. run build && electron .",
    "dev:linux": "npm --prefix ../.. run bundle:backend && npm --prefix ../.. run build && electron . --no-sandbox",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "dist:mac": "electron-builder --mac",
    "dist:all": "electron-builder --win --linux --mac"
  },
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9"
  },
  "build": {
    "appId": "com.voicenotes.app",
    "productName": "Voice Notes",
    "copyright": "Copyright © 2026 leisurehuang",
    "directories": {
      "buildResources": "resources",
      "output": "release"
    },
    "files": [
      "src/**",
      "../backend/dist/**",
      "../frontend/dist/**",
      "!**/*.ts",
      "!**/*.map",
      "!**/node_modules/*/{TEST,test,__tests__,tests}/**",
      "!**/node_modules/.github",
      "!**/*.md",
      "!**/.env*",
      "!**/.*"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/@anthropic-ai/sdk/**"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": ["arm64"]
        }
      ],
      "category": "public.app-category.utilities",
      "icon": "build/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "sign": false
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Voice Notes"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": ["x64"]
        }
      ],
      "icon": "build/icons",
      "category": "AudioVideo;Audio;Recorder",
      "description": "本地语音转笔记应用"
    },
    "appImage": {
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "extraResources": [
      {
        "from": "../../resources/bin/",
        "to": "bin/",
        "filter": "**/*"
      },
      {
        "from": "../../resources/models/",
        "to": "models/",
        "filter": "**/*"
      },
      {
        "from": "../../resources/ollama-models/",
        "to": "ollama-models/",
        "filter": "**/*"
      }
    ],
    "publish": {
      "provider": "github",
      "owner": "leisurehuang",
      "repo": "VoiceNote"
    }
  }
}
