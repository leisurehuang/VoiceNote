{
  "name": "@voice-notes/desktop",
  "version": "0.9.0",
  "private": true,
  "description": "Voice Notes 桌面外壳（Electron）",
  "main": "src/main.cjs",
  "author": "voice-notes",
  "repository": {
    "type": "git",
    "url": "https://github.com/leisurehuang/VoiceNote.git"
  },
  "scripts": {
    "dev": "npm --prefix ../.. run bundle:backend && npm --prefix ../.. run build && electron .",
    "dev:linux": "npm --prefix ../.. run bundle:backend && npm --prefix ../.. run build && electron . --no-sandbox",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "dist:mac": "electron-builder --mac",
    "dist:all": "electron-builder --win --linux --mac",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "uiohook-napi": "^1.5.5"
  }
}